# قاعدة البيانات — PostgreSQL (Supabase في الإنتاج، راجع docs/DEPLOY.md)
# التشغيل: Transaction pooler (6543) — إلزامي على Vercel (serverless).
# إن فشلت أوامر المخطط عبر DIRECT_URL مؤقتًا، أضف &statement_cache_size=0 إلى هذا الرابط واستخدمه كـ DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=5"
# أوامر المخطط: Session pooler (5432) — Transaction mode لا يدعم Prepared Statements.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# كلمة مرور الأدمين
ADMIN_PASSWORD=""

# سري لتوقيع جلسات الدخول
AUTH_SECRET=""

# رابط التطبيق
APP_URL="http://localhost:3000"

# Google Sheets (اختياري، تُربط لاحقًا)
# مفتاح الخدمة يُقرأ من متغير البيئة فقط — لا يُخزَّن في قاعدة البيانات ولا يُرسل للمتصفح.
# انسخ كامل JSON الخاص بالـ Service Account في سطر واحد.
# الاسم البديل GOOGLE_SERVICE_ACCOUNT_JSON مقبول أيضًا للتوافق.
GOOGLE_SA_JSON=""
# معرّف الجدول: يُضبط من إعدادات المتجر (/admin/settings)، ويمكن ضبطه هنا كبديل.
GOOGLE_SHEET_ID=""

# الصور (اختياري للرفع المباشر)
BLOB_READ_WRITE_TOKEN=""
